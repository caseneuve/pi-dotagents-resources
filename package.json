{
  "name": "pi-dotagents-resources",
  "version": "0.0.0",
  "description": "Themes and reusable prompt templates for Pi.",
  "type": "module",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Caseneuve",
  "keywords": [
    "pi-package",
    "pi",
    "agents",
    "extensions"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts",
    "prompts",
    "themes"
  ],
  "pi": {
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "scripts": {
    "check": "biome check --write --error-on-warnings .",
    "check:ci": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check:ci && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run --json",
    "prepare": "node scripts/install-prek-hook.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@j178/prek": "0.4.14",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caseneuve/pi-dotagents-resources.git"
  },
  "bugs": {
    "url": "https://github.com/caseneuve/pi-dotagents-resources/issues"
  },
  "homepage": "https://github.com/caseneuve/pi-dotagents-resources#readme"
}
